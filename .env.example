# Copia este archivo como ".env" y completa los valores.
# El archivo .env contiene tu clave: no lo compartas ni lo subas a un repositorio.

# Clave de OpenAI (https://platform.openai.com/api-keys). Obligatoria.
OPENAI_API_KEY=

# PIN para la página de control. Si se deja vacío, se genera uno nuevo en cada arranque.
ADMIN_PIN=

# Idiomas que se ofrecen a los oyentes, separados por coma.
# Disponibles: en,pt,fr,de,it,ja,ko,zh,ru,hi,id,vi
LANGUAGES=en,pt,fr,de,it,ja,ko,zh,ru,hi,id,vi

# Dirección que abre el QR. Vacío = la IP de esta computadora en el wifi.
# Si usas un túnel o un servidor en la nube, pon aquí su dirección https.
PUBLIC_URL=

PORT=3000

# Motor de traducción: auto, translate o prompt (ver README).
TRANSLATE_ENGINE=auto

# Zona horaria para la fecha del PDF.
TIME_ZONE=America/Mexico_City
